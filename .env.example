# sangaku-matcher environment variables

# Paths (defaults work for standard setup)
# MATCHER_DB_PATH=./data/matcher.db
# IR_COLLECTOR_DB_PATH=~/projects/apps/ir-collector/data/ir.db

# API Keys (optional for Phase 1)
# ANTHROPIC_API_KEY=sk-ant-...
# EDINET_API_KEY=...
# SEMANTIC_SCHOLAR_API_KEY=...

# Web server
HOST=127.0.0.1
PORT=8000

# Scoring weights (Phase 1)
W_TECH_PROX=0.35
W_ABS_CAP=0.35
W_PAST_TIES=0.30

# Embedding model
EMBEDDING_MODEL=intfloat/multilingual-e5-small
