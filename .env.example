# sangaku-matcher environment variables

# Paths (defaults work for standard setup)
# MATCHER_DB_PATH=./data/matcher.db
# IR_COLLECTOR_DB_PATH=~/projects/apps/ir-collector/data/ir.db

# API Keys (optional for Phase 1)
# ANTHROPIC_API_KEY=sk-ant-...
# EDINET_API_KEY=...
# SEMANTIC_SCHOLAR_API_KEY=...

# Web server
HOST=127.0.0.1
PORT=8000

# Scoring weights: Seven-Dimension Value Model (sum=1.0)
# Based on Nooteboom (2007), SHARPE framework, Mode 2 theory
W_TECH_PROX=0.15
W_NEED_FIT=0.15
W_ABS_CAP=0.10
W_OPEN_INNO=0.10
W_PAST_TIES=0.05
W_FUTURE_OPTION=0.10
W_HUMANITIES_FIT=0.25
W_SYNERGY=0.10

# Embedding model
EMBEDDING_MODEL=intfloat/multilingual-e5-small
